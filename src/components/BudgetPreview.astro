---
import AndroidFrame from './AndroidFrame.astro';

interface Props {
  mode?: 'interactive' | 'static' | 'compact';
  showEnvelopes?: boolean;
}

const {
  mode = 'static',
  showEnvelopes = true,
} = Astro.props;
---

<AndroidFrame accent="budget" badgeText="App preview">
  <div class="p-4 flex flex-col h-full bg-[#141E18] text-stone-100 select-none font-sans">
    
    <!-- App Bar -->
    <div class="flex items-center justify-between pb-3 border-b border-emerald-950/60">
      <div class="flex items-center gap-2">
        <div class="w-7 h-7 rounded-lg bg-emerald-800/80 border border-emerald-600/50 flex items-center justify-center text-emerald-200">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <div>
          <div class="text-xs font-bold tracking-tight text-white">The Simpler Budget</div>
          <div class="text-[10px] text-emerald-400/80 flex items-center gap-1">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
            On-device &bull; No bank link
          </div>
        </div>
      </div>
      <span class="text-[10px] px-2 py-0.5 rounded bg-emerald-950 border border-emerald-800/40 text-emerald-300">
        Local only
      </span>
    </div>

    <!-- Voice Capture Highlight -->
    <div class="mt-3 bg-stone-900/80 rounded-xl p-2.5 border border-emerald-900/40">
      <div class="flex items-center gap-2 text-xs text-stone-300">
        <div class="w-5 h-5 rounded-full bg-emerald-900/80 text-emerald-300 flex items-center justify-center shrink-0">
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z" />
          </svg>
        </div>
        <div class="flex-1 truncate">
          <span class="text-stone-400 text-[10px] block">Voice note captured:</span>
          <span class="font-medium text-white text-[11px]">“I spent $12.50 on lunch at Panera”</span>
        </div>
      </div>
    </div>

    <!-- Review Step Card (Prominently featured) -->
    <div class="mt-3 bg-gradient-to-b from-[#1C2B22] to-[#16221B] rounded-2xl p-3.5 border border-emerald-700/40 shadow-inner flex-1 flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between mb-2">
          <span class="text-[11px] font-semibold text-emerald-300 uppercase tracking-wider flex items-center gap-1">
            <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            Review AI Draft
          </span>
          <span class="text-[10px] text-stone-400 bg-stone-900/60 px-2 py-0.5 rounded-full border border-stone-750">
            Tap to edit any field
          </span>
        </div>

        <!-- Draft Fields -->
        <div class="space-y-2 text-left">
          <!-- Amount -->
          <div class="bg-black/30 rounded-lg p-2 border border-emerald-900/30 flex items-center justify-between">
            <span class="text-[10px] text-stone-400">Amount</span>
            <div class="flex items-center gap-1">
              <span class="text-sm font-bold text-white">$12.50</span>
              <svg class="w-3 h-3 text-stone-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
              </svg>
            </div>
          </div>

          <!-- Merchant -->
          <div class="bg-black/30 rounded-lg p-2 border border-emerald-900/30 flex items-center justify-between">
            <span class="text-[10px] text-stone-400">Merchant</span>
            <div class="flex items-center gap-1">
              <span class="text-xs font-semibold text-stone-100">Panera Bread</span>
              <svg class="w-3 h-3 text-stone-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
              </svg>
            </div>
          </div>

          <!-- Category Envelope -->
          <div class="bg-black/30 rounded-lg p-2 border border-emerald-900/30 flex items-center justify-between">
            <div>
              <span class="text-[10px] text-stone-400 block">Assigned Envelope</span>
              <span class="text-[9px] text-emerald-400">Matched via AI context</span>
            </div>
            <div class="flex items-center gap-1 bg-emerald-900/60 px-2 py-0.5 rounded border border-emerald-700/60">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
              <span class="text-xs font-medium text-emerald-200">Dining Out</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Review Confirmation Action -->
      <div class="mt-3 pt-2 border-t border-emerald-900/40 flex items-center gap-2">
        <div class="flex-1 py-1.5 px-3 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-semibold text-center shadow flex items-center justify-center gap-1.5">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
          Confirm & Save
        </div>
        <div class="py-1.5 px-2 rounded-lg bg-stone-800 text-stone-400 text-xs text-center border border-stone-700">
          Edit
        </div>
      </div>
    </div>

    {showEnvelopes && (
      <div class="mt-3 pt-2 border-t border-emerald-950/60">
        <div class="flex items-center justify-between text-[10px] text-stone-400 mb-1.5 font-medium">
          <span>Digital Envelopes</span>
          <span class="text-emerald-400">3 of 6 active</span>
        </div>

        <div class="space-y-1.5">
          <div class="bg-stone-900/70 rounded-lg p-1.5 border border-stone-800 text-[10px]">
            <div class="flex justify-between items-center mb-0.5">
              <span class="font-medium text-stone-200">Dining Out</span>
              <span class="text-stone-300 font-semibold">$87.50 <span class="text-stone-500 font-normal">/ $150</span></span>
            </div>
            <div class="w-full bg-stone-800 h-1.5 rounded-full overflow-hidden">
              <div class="bg-emerald-500 h-full rounded-full" style="width: 58%"></div>
            </div>
          </div>

          <div class="bg-stone-900/70 rounded-lg p-1.5 border border-stone-800 text-[10px]">
            <div class="flex justify-between items-center mb-0.5">
              <span class="font-medium text-stone-200">Groceries</span>
              <span class="text-stone-300 font-semibold">$320.00 <span class="text-stone-500 font-normal">/ $450</span></span>
            </div>
            <div class="w-full bg-stone-800 h-1.5 rounded-full overflow-hidden">
              <div class="bg-emerald-400 h-full rounded-full" style="width: 71%"></div>
            </div>
          </div>

          <div class="bg-stone-900/70 rounded-lg p-1.5 border border-stone-800 text-[10px]">
            <div class="flex justify-between items-center mb-0.5">
              <span class="font-medium text-stone-200">Gas</span>
              <span class="text-stone-300 font-semibold">$65.00 <span class="text-stone-500 font-normal">/ $100</span></span>
            </div>
            <div class="w-full bg-stone-800 h-1.5 rounded-full overflow-hidden">
              <div class="bg-emerald-400 h-full rounded-full" style="width: 65%"></div>
            </div>
          </div>
        </div>
      </div>
    )}

  </div>
</AndroidFrame>

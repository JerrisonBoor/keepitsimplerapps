---
import { SITE } from '../data/site';
---

<footer class="mt-auto border-t border-[#E7E2D8] bg-[#FAF8F5] text-stone-600 text-xs py-12 px-4 sm:px-6">
  <div class="max-w-6xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-10">
      
      <!-- Brand column -->
      <div class="md:col-span-2 space-y-3">
        <div class="flex items-center gap-2">
          <div class="w-6 h-6 rounded-lg bg-stone-900 text-stone-100 flex items-center justify-center font-bold text-xs">
            KS
          </div>
          <span class="font-bold text-stone-900 text-sm">
            Keep It Simpler
          </span>
        </div>
        <p class="text-stone-600 text-xs leading-relaxed max-w-sm">
          A family of focused apps that use built-in AI to make everyday tracking effortless. First planned launch coming soon for Android, with your data remaining securely on your phone.
        </p>
        <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-[#F3EFE8] text-stone-700 text-[11px] font-medium border border-[#E5E0D5]">
          <svg class="w-3.5 h-3.5 text-emerald-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
          On-device records &bull; No app account required
        </div>
      </div>

      <!-- Apps column -->
      <div>
        <h4 class="font-bold text-stone-900 text-xs uppercase tracking-wider mb-3">
          Apps
        </h4>
        <ul class="space-y-2">
          <li>
            <a href="/budget" class="hover:text-stone-950 transition inline-flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
              The Simpler Budget
            </a>
          </li>
          <li>
            <a href="/nutrition" class="hover:text-stone-950 transition inline-flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-amber-600"></span>
              The Simpler Nutrition
            </a>
          </li>
          <li class="pt-1 text-[11px] text-stone-500 italic">
            More everyday tools coming
          </li>
        </ul>
      </div>

      <!-- Legal & Transparency column -->
      <div>
        <h4 class="font-bold text-stone-900 text-xs uppercase tracking-wider mb-3">
          Transparency
        </h4>
        <ul class="space-y-2">
          <li>
            <a href="/privacy" class="hover:text-stone-950 transition">
              Privacy Notice
            </a>
          </li>
          <li>
            <a href="#signup" class="hover:text-stone-950 transition">
              Beta Testing Interest
            </a>
          </li>
          <li>
            <span class="text-stone-500">Android 11+ first release</span>
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom separation notice and copyright -->
    <div class="pt-8 border-t border-[#E7E2D8] flex flex-col sm:flex-row items-center justify-between gap-4 text-[11px] text-stone-500">
      <p>
        &copy; {new Date().getFullYear()} Keep It Simpler. All rights reserved. Target domain: <code class="font-mono text-stone-700">keepitsimpler.app</code>.
      </p>
      <p class="text-center sm:text-right max-w-md">
        Signup information collected on this website is stored independently from the records inside our apps.
      </p>
    </div>
  </div>
</footer>

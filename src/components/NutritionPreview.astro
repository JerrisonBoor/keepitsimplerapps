---
import AndroidFrame from './AndroidFrame.astro';

interface Props {
  mode?: 'interactive' | 'static' | 'compact';
  showDailyTotal?: boolean;
}

const {
  mode = 'static',
  showDailyTotal = true,
} = Astro.props;
---

<AndroidFrame accent="nutrition" badgeText="App preview">
  <div class="p-4 flex flex-col h-full bg-[#1C1714] text-stone-100 select-none font-sans">
    
    <!-- App Bar -->
    <div class="flex items-center justify-between pb-3 border-b border-amber-950/60">
      <div class="flex items-center gap-2">
        <div class="w-7 h-7 rounded-lg bg-amber-800/80 border border-amber-600/50 flex items-center justify-center text-amber-200">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3" />
          </svg>
        </div>
        <div>
          <div class="text-xs font-bold tracking-tight text-white">The Simpler Nutrition</div>
          <div class="text-[10px] text-amber-400/80 flex items-center gap-1">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
            On-device &bull; Private food log
          </div>
        </div>
      </div>
      <span class="text-[10px] px-2 py-0.5 rounded bg-amber-950 border border-amber-800/40 text-amber-300">
        Local log
      </span>
    </div>

    <!-- Voice Transcript Bubble -->
    <div class="mt-3 bg-stone-900/80 rounded-xl p-2.5 border border-amber-900/40">
      <div class="flex items-center gap-2 text-xs text-stone-300">
        <div class="w-5 h-5 rounded-full bg-amber-900/80 text-amber-300 flex items-center justify-center shrink-0">
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z" />
          </svg>
        </div>
        <div class="flex-1 truncate">
          <span class="text-stone-400 text-[10px] block">Voice meal described:</span>
          <span class="font-medium text-white text-[11px]">“Three eggs, a New York strip steak, and two slices of sourdough”</span>
        </div>
      </div>
    </div>

    <!-- Review Step Card with Itemized Breakdown -->
    <div class="mt-3 bg-gradient-to-b from-[#2B1D16] to-[#20150F] rounded-2xl p-3.5 border border-amber-700/40 shadow-inner flex-1 flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between mb-2">
          <span class="text-[11px] font-semibold text-amber-300 uppercase tracking-wider flex items-center gap-1">
            <svg class="w-3.5 h-3.5 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            Review Meal Draft
          </span>
          <span class="text-[10px] text-amber-300/80 bg-amber-950/80 px-2 py-0.5 rounded-full border border-amber-800/60 font-medium">
            Sample estimates
          </span>
        </div>

        <!-- Estimated Totals Header -->
        <div class="bg-black/35 rounded-xl p-2.5 border border-amber-900/30 mb-2">
          <div class="flex items-baseline justify-between">
            <span class="text-[11px] text-stone-400">Total estimated energy</span>
            <div class="text-right">
              <span class="text-base font-bold text-white">~970</span>
              <span class="text-[10px] text-amber-400 font-semibold ml-0.5">kcal (est.)</span>
            </div>
          </div>
          <!-- Macros row -->
          <div class="grid grid-cols-3 gap-1 mt-1.5 pt-1.5 border-t border-stone-800/80 text-center text-[10px]">
            <div class="bg-stone-900/60 py-1 rounded">
              <span class="text-stone-400 block text-[9px]">Protein</span>
              <span class="font-bold text-amber-200">80g</span>
            </div>
            <div class="bg-stone-900/60 py-1 rounded">
              <span class="text-stone-400 block text-[9px]">Carbs</span>
              <span class="font-bold text-amber-200">47g</span>
            </div>
            <div class="bg-stone-900/60 py-1 rounded">
              <span class="text-stone-400 block text-[9px]">Fat</span>
              <span class="font-bold text-amber-200">49g</span>
            </div>
          </div>
        </div>

        <!-- Itemized Food Items (Editable) -->
        <div class="space-y-1.5 text-left">
          <!-- Item 1: Eggs -->
          <div class="bg-stone-900/80 rounded-lg p-2 border border-stone-800 flex items-center justify-between text-[11px]">
            <div>
              <div class="font-medium text-stone-100 flex items-center gap-1.5">
                <span>3 large whole eggs</span>
              </div>
              <span class="text-[9px] text-stone-400">~210 kcal &bull; 18g P &bull; 1.5g C &bull; 15g F</span>
            </div>
            <button type="button" aria-label="Edit eggs portion" class="text-stone-400 hover:text-amber-300 p-1">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
              </svg>
            </button>
          </div>

          <!-- Item 2: NY Strip Steak -->
          <div class="bg-stone-900/80 rounded-lg p-2 border border-stone-800 flex items-center justify-between text-[11px]">
            <div>
              <div class="font-medium text-stone-100 flex items-center gap-1.5">
                <span>NY strip steak (8 oz)</span>
              </div>
              <span class="text-[9px] text-stone-400">~520 kcal &bull; 54g P &bull; 0g C &bull; 32g F</span>
            </div>
            <button type="button" aria-label="Edit steak portion" class="text-stone-400 hover:text-amber-300 p-1">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
              </svg>
            </button>
          </div>

          <!-- Item 3: Sourdough -->
          <div class="bg-stone-900/80 rounded-lg p-2 border border-stone-800 flex items-center justify-between text-[11px]">
            <div>
              <div class="font-medium text-stone-100 flex items-center gap-1.5">
                <span>Sourdough bread (2 slices)</span>
              </div>
              <span class="text-[9px] text-stone-400">~240 kcal &bull; 8g P &bull; 46g C &bull; 2g F</span>
            </div>
            <button type="button" aria-label="Edit sourdough portion" class="text-stone-400 hover:text-amber-300 p-1">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
              </svg>
            </button>
          </div>
        </div>
      </div>

      <!-- Action Buttons: Save Now or Draft for Later -->
      <div class="mt-3 pt-2 border-t border-amber-900/40 flex items-center gap-2">
        <div class="flex-1 py-1.5 px-3 rounded-lg bg-amber-600 hover:bg-amber-500 text-white text-xs font-semibold text-center shadow flex items-center justify-center gap-1.5">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
          Save to Meal Log
        </div>
        <div class="py-1.5 px-2 rounded-lg bg-stone-800 text-stone-300 text-[10px] text-center border border-stone-700 whitespace-nowrap">
          Draft for Later
        </div>
      </div>
    </div>

    {showDailyTotal && (
      <div class="mt-3 pt-2 border-t border-amber-950/60">
        <div class="flex items-center justify-between text-[10px] text-stone-400 mb-1">
          <span class="font-medium">On-Device Daily History</span>
          <span class="text-amber-400 font-semibold">Today: ~1,740 kcal</span>
        </div>
        <div class="flex items-center gap-2 bg-stone-900/70 p-1.5 rounded-lg border border-stone-800 text-[10px]">
          <span class="px-1.5 py-0.5 rounded bg-stone-800 text-stone-300 font-medium">Breakfast</span>
          <span class="text-stone-400 truncate">Oatmeal with blueberries, black coffee</span>
          <span class="text-stone-300 font-semibold ml-auto shrink-0">~420 kcal</span>
        </div>
      </div>
    )}

  </div>
</AndroidFrame>

---
interface Props {
  title?: string;
  badgeText?: string;
  accent?: 'budget' | 'nutrition' | 'neutral';
  class?: string;
}

const {
  title = 'App preview',
  badgeText = 'App preview',
  accent = 'neutral',
  class: className = '',
} = Astro.props;

const badgeColors = {
  budget: 'bg-emerald-950/80 text-emerald-300 border-emerald-700/50',
  nutrition: 'bg-stone-900/90 text-amber-300 border-amber-700/50',
  neutral: 'bg-stone-900/90 text-stone-300 border-stone-700/50',
};
---

<div class={`relative mx-auto w-full max-w-[340px] sm:max-w-[370px] ${className}`}>
  <!-- Floating App Preview Tag -->
  <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 z-20">
    <span class={`inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-medium tracking-wide uppercase shadow-md border backdrop-blur-md ${badgeColors[accent]}`}>
      <span class="w-1.5 h-1.5 rounded-full bg-current pulse-indicator"></span>
      {badgeText}
    </span>
  </div>

  <!-- Android Phone Mockup Frame -->
  <div class="relative rounded-[40px] p-2.5 bg-stone-900 ring-1 ring-white/20 device-shadow-lg">
    <!-- Outer screen border -->
    <div class="relative rounded-[32px] overflow-hidden bg-stone-950 border border-stone-800 text-stone-100 flex flex-col min-h-[580px] select-none">
      
      <!-- Android Status Bar -->
      <div class="h-8 px-5 flex items-center justify-between text-[11px] font-medium text-stone-400 bg-stone-950/90 border-b border-stone-850 z-10 shrink-0">
        <span>9:41</span>
        
        <!-- Front Camera Hole -->
        <div class="w-3.5 h-3.5 rounded-full bg-stone-900 ring-1 ring-stone-800 flex items-center justify-center">
          <div class="w-1.5 h-1.5 rounded-full bg-stone-950"></div>
        </div>

        <!-- System Icons (Signal, Wifi, Battery) -->
        <div class="flex items-center gap-1.5 tracking-tight">
          <svg class="w-3 h-3 fill-current" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 3c-4.97 0-9 4.03-9 9 0 2.12.74 4.07 1.97 5.61L12 22l7.03-4.39C20.26 16.07 21 14.12 21 12c0-4.97-4.03-9-9-9z" opacity="0.3"/>
            <path d="M12 6c-3.31 0-6 2.69-6 6 0 1.41.49 2.71 1.31 3.74L12 18.5l4.69-2.76C17.51 14.71 18 13.41 18 12c0-3.31-2.69-6-6-6z"/>
          </svg>
          <svg class="w-3 h-3 fill-current" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 4C7.31 4 3.07 5.9 0 8.98L12 21 24 8.98C20.93 5.9 16.69 4 12 4zm0 3.5c3.27 0 6.27 1.25 8.54 3.32L12 19.34 3.46 10.82C5.73 8.75 8.73 7.5 12 7.5z"/>
          </svg>
          <span class="text-[10px] font-semibold text-stone-300">100%</span>
        </div>
      </div>

      <!-- App Content Slot -->
      <div class="flex-1 flex flex-col overflow-hidden bg-stone-900 text-stone-100">
        <slot />
      </div>

      <!-- Android Navigation Bar Indicator -->
      <div class="h-5 bg-stone-950 flex items-center justify-center shrink-0">
        <div class="w-28 h-1 rounded-full bg-stone-700"></div>
      </div>
    </div>
  </div>
</div>
